{
  "name": "homepage-bulma",
  "version": "1.0.1",
  "description": "CV website made with Bulma framework",
  "main": "scss/main.scss",
  "scripts": {
    "css-build": "sass --load-path=node_modules --no-source-map --quiet-deps scss/main.scss:css/main.css",
    "css-build-dev": "sass --load-path=node_modules --quiet-deps scss/main.scss:css/main.css",
    "css-watch": "sass --load-path=node_modules --quiet-deps scss/main.scss:css/main.css --watch",
    "dev": "pnpm run css-build-dev && APP_ENV=local php -S localhost:8080 router.php",
    "dev-start": "pnpm run css-build-dev && concurrently -n css,php -c yellow,cyan \"pnpm run css-watch\" \"APP_ENV=local php -S localhost:8080 router.php\"",
    "start": "pnpm run css-watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aapok0/homepage-bulma"
  },
  "keywords": [
    "html",
    "css",
    "php",
    "javascript",
    "bulma"
  ],
  "author": "Aapo Kokko",
  "license": "ISC",
  "devDependencies": {
    "bulma": "^1.0.4",
    "concurrently": "^9.1.2",
    "sass": "^1.101.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
